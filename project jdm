// ══════════════════════════════════════════════
//  BUILD SELECTORS
// ══════════════════════════════════════════════
const selYear  = document.getElementById('sel-year');
const selMake  = document.getElementById('sel-make');
const selModel = document.getElementById('sel-model');

// Populate years
const allYears = new Set();
Object.values(FITMENT_DB).forEach(makes =>
  Object.values(makes).forEach(m => m.years.forEach(y => allYears.add(y)))
);
[...allYears].sort((a,b)=>b-a).forEach(y => {
  const o = new Option(y, y);
  selYear.add(o);
});

selYear.addEventListener('change', () => {
  const yr = parseInt(selYear.value);
  selMake.innerHTML = '<option value="">— Select Make —</option>';
  selModel.innerHTML = '<option value="">— Select Model —</option>';
  selMake.disabled = !yr;
  selModel.disabled = true;

  if (!yr) return;
  Object.entries(FITMENT_DB).forEach(([make, models]) => {
    const hasYear = Object.values(models).some(m => m.years.includes(yr));
    if (hasYear) selMake.add(new Option(make, make));
  });
});

selMake.addEventListener('change', () => {
  const yr   = parseInt(selYear.value);
  const make = selMake.value;
  selModel.innerHTML = '<option value="">— Select Model —</option>';
  selModel.disabled = !make;
  if (!make) return;

  Object.entries(FITMENT_DB[make] || {}).forEach(([model, data]) => {
    if (data.years.includes(yr)) selModel.add(new Option(model, model));
  });
});

// ══════════════════════════════════════════════
//  SEARCH & RENDER
// ══════════════════════════════════════════════
let activeSize = null;

function doSearch() {
  const yr    = parseInt(selYear.value);
  const make  = selMake.value;
  const model = selModel.value;
  if (!yr || !make || !model) {
    alert('Please select a Year, Make, and Model first.');
    return;
  }

  const data = FITMENT_DB[make]?.[model];
  if (!data) return;

  activeSize = null;
  document.getElementById('empty-state').style.display = 'none';
  document.getElementById('results-content').style.display = 'block';
  renderResults(yr, make, model, data);
}

function renderResults(yr, make, model, data) {
  const el = document.getElementById('results-content');
  const sizes = data.fitments.map(f => f.size);
  const defaultSize = activeSize || sizes[0];

  el.innerHTML = `
    <div class="results-header">
      <h3>FITMENT RESULTS</h3>
      <span class="vehicle-name">${yr} ${make} ${model}</span>
    </div>

    <!-- Stock Info -->
    <div class="stock-info">
      ⚙ &nbsp; OEM SPECS: &nbsp; Bolt Pattern: <strong>${data.stock.bolt}</strong> &nbsp;|&nbsp;
      Offset: <strong>${data.stock.offset}</strong> &nbsp;|&nbsp;
      Center Bore: <strong>${data.stock.bore}</strong> &nbsp;|&nbsp;
      Lug Size: <strong>${data.stock.lug}</strong>
    </div>

    <!-- Size Tabs -->
    <div style="margin-top:1.5rem;margin-bottom:0">
      <div class="size-tabs" id="size-tabs">
        ${sizes.map(s => `
          <button class="size-tab ${s===defaultSize?'active':''}" onclick="switchSize(${s}, '${yr}', '${make}', '${model}')">
            ${s}" WHEEL
          </button>`).join('')}
      </div>
    </div>

    <!-- Cards -->
    <div id="fitment-cards" style="margin-top:1.5rem"></div>
  `;

  renderCards(yr, make, model, data, defaultSize);
}

function switchSize(size, yr, make, model) {
  activeSize = size;
  document.querySelectorAll('.size-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.size-tab').forEach(t => {
    if (t.textContent.trim().startsWith(size)) t.classList.add('active');
  });
  const data = FITMENT_DB[make]?.[model];
  renderCards(yr, make, model, data, size);
}

function renderCards(yr, make, model, data, targetSize) {
  const container = document.getElementById('fitment-cards');
  const fitment = data.fitments.find(f => f.size === targetSize);
  if (!fitment) return;

  const cards = buildFitmentVariants(fitment, yr, make, model);
  container.innerHTML = `<div class="fitment-grid">${cards}</div>`;
}

function buildFitmentVariants(fitment, yr, make, model) {
  // Generate 3 fitment style cards per size: Flush, Street, Stance
  const styles = [
    { label: "FLUSH FIT",   offsetNote: "Stock offset range", highlight: false },
    { label: "STREET FIT",  offsetNote: "Slight poke, aggressive", highlight: true },
    { label: "STANCE FIT",  offsetNote: "Low offset, wide stance", highlight: false },
  ];

  return styles.map((style, i) => {
    const tire = fitment.tires[i] || fitment.tires[0];
    const tireAll = fitment.tires;
    const delay = i * 80;

    return `
    <div class="fitment-card" style="animation-delay:${delay}ms">
      <div class="card-header">
        <div class="wheel-size-badge">
          ${fitment.size}"
          <span>WHEEL SIZE</span>
        </div>
        <div class="fitment-badge">${style.label}</div>
      </div>
      <div class="card-body">
        <div class="spec-row">
          <span class="spec-label">Width</span>
          <span class="spec-value">${fitment.width}</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Offset Range</span>
          <span class="spec-value ${style.highlight?'highlight':''}">${fitment.offset}</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Fit Style</span>
          <span class="spec-value" style="color:var(--gray);font-size:0.8rem">${style.offsetNote}</span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Recommended Tire</span>
          <span class="spec-value highlight">${tire}</span>
        </div>

        <div class="tire-sizes">
          <div class="tire-sizes-label">⬡ Compatible Tire Sizes for ${fitment.size}" Wheel</div>
          ${tireAll.map(t => `<span class="tire-tag">${t}</span>`).join('')}
        </div>
      </div>
    </div>`;
  }).join('');
}
</script>
